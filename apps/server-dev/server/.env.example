# ============================================================
# qoder 监控系统后端环境变量示例
# 复制此文件为 .env 并填写实际值
# 遵循质量原则第 6 原则：配置即代码，DATABASE_URL 必须来自环境变量
# ============================================================

# --- 数据库配置（必需，fail-fast 校验）---
# PostgreSQL 连接字符串，格式：postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=<schema>
# 遵循质量原则第 6 原则：启动时校验，缺失则拒绝启动
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qoder_monitor?schema=public"

# --- 应用配置（可选）---
# 运行环境：development | production
NODE_ENV=development

# API 端口（REST + WebSocket 共用，需求确认报告 §1）
PORT=3000

# CORS 允许的 origin（逗号分隔，统一接口文档 §5.1）
# 开发默认 "*"；生产环境强烈建议显式列出前端 SPA origin 与 Ext origin
# 例如：CORS_ORIGINS=http://localhost:5173,chrome-extension://<extension-id>
CORS_ORIGINS=*

# --- 监控与生命周期配置（可选，后端设计 §5）---
# 离线检测阈值 ms（默认 30000 = 3 × 采集周期 10s，解决 R-002）
# STALE_THRESHOLD_MS=30000
# 离线检测扫描间隔 ms（默认 10000）
# STALE_DETECTOR_INTERVAL_MS=10000
# WebSocket 心跳 ping 间隔 ms（默认 30000）
# WS_HEARTBEAT_INTERVAL_MS=30000

# 数据保留天数（默认 30，解决 R-004；0=禁用自动清理交由运维手动管理）
# RETENTION_DAYS=30
# 数据保留清理扫描间隔 ms（默认 86400000 = 24h）
# RETENTION_CRON_INTERVAL_MS=86400000

# --- 日志配置（可选）---
# pino 日志级别（默认 info）
# LOG_LEVEL=info
